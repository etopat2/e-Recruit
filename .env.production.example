COMPOSE_PROJECT_NAME=ups-erecruit-production
RELEASE_VERSION=1.0.0-REPLACE_WITH_COMMIT
API_IMAGE=registry.internal/ups/erecruit-api
WEB_IMAGE=registry.internal/ups/erecruit-web
WORKER_IMAGE=registry.internal/ups/erecruit-document-worker
APP_URL=https://recruitment.prisons.go.ug
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_show
APP_TIMEZONE=Africa/Kampala
TRUSTED_PROXIES=REPLACE_WITH_APPROVED_INGRESS_CIDR
LOG_LEVEL=info
POSTGRES_DB=erecruit
POSTGRES_USER=erecruit
POSTGRES_PASSWORD=INJECT_FROM_APPROVED_SECRET_STORE
REDIS_PASSWORD=INJECT_FROM_APPROVED_SECRET_STORE
MINIO_ROOT_USER=erecruit-minio
MINIO_ROOT_PASSWORD=INJECT_FROM_APPROVED_SECRET_STORE
MINIO_BUCKET=erecruit-private
DOCUMENT_WORKER_TOKEN=INJECT_RANDOM_32_BYTE_SECRET
DOCUMENT_WORKER_TIMEOUT_SECONDS=60
DOCUMENT_MAX_BYTES=15728640
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
OFFLINE_PACK_EXPIRY_HOURS=24
OFFLINE_PACK_MAXIMUM_RECORDS=1500
MAIL_HOST=approved-smtp.internal
MAIL_PORT=587
MAIL_USERNAME=INJECT_FROM_APPROVED_SECRET_STORE
MAIL_PASSWORD=INJECT_FROM_APPROVED_SECRET_STORE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@prisons.go.ug
MAIL_FROM_NAME=UPS e-Recruit
SMS_DRIVER=null
SMS_BASE_URL=
SMS_TOKEN=
SMS_TIMEOUT_SECONDS=15
PUSH_DRIVER=null
PUSH_BASE_URL=
PUSH_TOKEN=
PUSH_VAPID_PUBLIC_KEY=
PUSH_TIMEOUT_SECONDS=15
SESSION_LIFETIME=120
BACKUP_ROOT=/approved/encrypted/backup-target
EDGE_PORT=8080
