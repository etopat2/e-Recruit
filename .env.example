COMPOSE_PROJECT_NAME=ups-erecruit
POSTGRES_DB=erecruit
POSTGRES_USER=erecruit
POSTGRES_PASSWORD=change-this-development-password
REDIS_PASSWORD=change-this-development-password
MINIO_ROOT_USER=erecruit-minio
MINIO_ROOT_PASSWORD=change-this-development-password
MINIO_BUCKET=erecruit-private
DOCUMENT_WORKER_TOKEN=change-this-development-token
TAHOMA_FONT_DIR=./infra/fonts
PDF_TAHOMA_REGULAR_PATH=/opt/erecruit/fonts/tahoma.ttf
PDF_TAHOMA_BOLD_PATH=/opt/erecruit/fonts/tahomabd.ttf
INSTITUTION_SEARCH_CACHE_HOURS=24
INSTITUTION_DIRECTORY_TIMEOUT_SECONDS=30
EMIS_INSTITUTION_SYNC_PAGE_SIZE=1000
EMIS_INSTITUTION_SYNC_TIMEOUT_SECONDS=90
EMIS_INSTITUTION_SEARCH_URL=https://emis.go.ug/emis/public-search
NCHE_INSTITUTIONS_URL=https://unche.or.ug/institutions/
TVET_INSTITUTIONS_URL=https://tvet.go.ug/institutions
TVET_DIRECTORY_URL=https://tvet.go.ug/institution
APP_PORT=8080
WEB_PORT=5173
API_PORT=8000
WORKER_PORT=8001
POSTGRES_PORT=54321
REDIS_PORT=63791
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
# Local capture does not deliver to external inboxes. See testing.md for the
# bundled self-hosted mail server and required domain/DNS/port-25 setup.
MAIL_DELIVERY_MODE=capture
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_TIMEOUT_SECONDS=15
