APP_NAME="UPS e-Recruit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Kampala
SEED_DEMO_USERS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erecruit
DB_USERNAME=erecruit
DB_PASSWORD=replace-with-database-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-redis-secret
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=erecruit-minio
AWS_SECRET_ACCESS_KEY=replace-with-object-storage-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=erecruit-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

APPLICATION_REFERENCE_PATTERN="UPS/{year}/{post}/{sequence}"
APPLICATION_REFERENCE_DIGITS=6
DOCUMENT_DISK=s3
DOCUMENT_MAX_BYTES=15728640
DOCUMENT_WORKER_URL=http://document-worker:8001
DOCUMENT_WORKER_TOKEN=replace-with-long-internal-token
DOCUMENT_WORKER_TIMEOUT_SECONDS=60
MALWARE_SCANNER=development
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
OFFLINE_PACK_EXPIRY_HOURS=24
OFFLINE_PACK_MAXIMUM_RECORDS=1500

VITE_APP_NAME="${APP_NAME}"
